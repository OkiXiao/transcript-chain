{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/auth/validate-email.js": { "maxDuration": 15 },
        "api/admin.js": { "maxDuration": 10 },
        "api/school/upload-pdf.js": { "maxDuration": 60 }
    }
}
