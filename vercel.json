{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/auth/validate-email.js": { "maxDuration": 15 },
        "api/auth/add-student-email.js": { "maxDuration": 10 },
        "api/auth/students/list.js": { "maxDuration": 10 },
        "api/admin.js": { "maxDuration": 10 },
        "api/nim/lookup.js": { "maxDuration": 10 },
        "api/nim/register.js": { "maxDuration": 60 },
        "api/school/upload-pdf.js": { "maxDuration": 60 },
        "api/school/submit-transcript.js": { "maxDuration": 10 },
        "api/school/requests.js": { "maxDuration": 10 },
        "api/student/pending-transcripts.js": { "maxDuration": 10 },
        "api/student/approve-transcript.js": { "maxDuration": 10 },
        "api/ministry/requests.js": { "maxDuration": 10 }
    }
}
