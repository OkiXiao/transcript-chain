# Sepolia Testnet
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here

# Pinata IPFS
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key

# TranscriptNFT Contract (filled after deployment)
CONTRACT_ADDRESS=0x_deployed_contract_address

# ── UserRegistry RBAC ─────────────────────────────────────────────────────
# Private key backend signer — BEDA dengan DEPLOYER_PRIVATE_KEY!
# Generate baru: node -e "const {ethers}=require('ethers');console.log(ethers.Wallet.createRandom().privateKey)"
REGISTRY_SIGNER_PRIVATE_KEY=0x_generate_a_new_private_key_for_backend_signing

# Alamat UserRegistry setelah deploy (dari scripts/deployRegistry.js)
USER_REGISTRY_ADDRESS=0x_deployed_registry_address

# RPC URL untuk fetch nonce dari chain (bisa sama dengan SEPOLIA_RPC_URL)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
